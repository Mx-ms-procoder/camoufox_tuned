## ─── Camoufox Slim Runtime Image ─────────────────────────────────────
# Optimized for Kubernetes pod startup (<2s target).
# Multi-stage build: Go sidecar compilation + minimal Python runtime.
#
# Build:
#   docker build -f Dockerfile.slim -t camoufox-slim .
#
# Run (session broker):
#   docker run -p 8000:8000 camoufox-slim
#
# Run (with Redis backend):
#   docker run -e CAMOUFOX_STORE_BACKEND=redis \
#              -e CAMOUFOX_REDIS_URL=redis://redis:6379/0 \
#              -p 8000:8000 camoufox-slim

# ── Stage 1: Build Go uTLS sidecar (EXPERIMENTAL — off default path) ──
# See K-3 / K-8 in AUDIT_2026-05-18.md. The source moved to
# bundle/_experimental/ because no registered TLS profile selects it.
FROM golang:1.25-bookworm AS go-builder

WORKDIR /build
COPY bundle/_experimental/go.mod bundle/_experimental/go.sum* ./
RUN go mod download 2>/dev/null || true

COPY bundle/_experimental/utls_proxy.go .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o /utls_proxy ./utls_proxy.go

# ── Stage 2: Minimal Python runtime ─────────────────────────────────
FROM ubuntu:22.04 AS runtime

# Prevent interactive prompts during apt install
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install only essential packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    # Minimal font set for realistic fingerprints
    fonts-liberation \
    fonts-noto-core \
    fonts-dejavu-core \
    # X11 for headful mode (Xvfb)
    xvfb \
    # CA certificates for TLS
    ca-certificates \
    # HTTP client for health checks
    curl \
    # Process management
    tini \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copy Go sidecar binary
COPY --from=go-builder /utls_proxy /usr/local/bin/utls_proxy
RUN chmod +x /usr/local/bin/utls_proxy

# Install Python dependencies (minimal)
WORKDIR /app
COPY pythonlib/ /app/pythonlib/
COPY requirements.txt /app/
RUN pip3 install --no-cache-dir --break-system-packages \
    -r requirements.txt \
    && pip3 install --no-cache-dir --break-system-packages \
    /app/pythonlib/ \
    2>/dev/null || pip3 install --no-cache-dir \
    -r requirements.txt \
    && pip3 install --no-cache-dir /app/pythonlib/

# Bake a Camoufox browser artifact into the image so runtime session
# creation does not have to call CamoufoxFetcher().install() and hit
# GitHub Releases. Default is now ON for B-005 / AUDIT_2026-05-17 so the
# container is self-contained. Disable with --build-arg
# CAMOUFOX_BAKE_BROWSER=0 if you intend to mount a prebuilt browser at
# runtime instead. Pin a release with --build-arg
# CAMOUFOX_FETCH_ARGS="--version <pinned>".
ARG CAMOUFOX_BAKE_BROWSER=1
ARG CAMOUFOX_FETCH_ARGS=""
RUN if [ "$CAMOUFOX_BAKE_BROWSER" = "1" ]; then \
        python3 -m camoufox fetch ${CAMOUFOX_FETCH_ARGS}; \
    else \
        echo "WARNING: Skipping browser bake (CAMOUFOX_BAKE_BROWSER=0). " \
             "Runtime will fetch from GitHub Releases on first use; the " \
             "image is NOT self-contained."; \
    fi

# Copy font configurations
COPY bundle/fontconfigs/ /etc/fonts/conf.d/
COPY bundle/fonts/ /usr/share/fonts/camoufox/

# Refresh font cache
RUN fc-cache -f 2>/dev/null || true

# Create non-root user
RUN useradd -r -s /bin/false camoufox \
    && mkdir -p /var/lib/camoufox/snapshots \
    && chown -R camoufox:camoufox /var/lib/camoufox

# Health check scripts
COPY --chmod=755 <<'EOF' /usr/local/bin/health-check.sh
#!/bin/sh
curl -sf http://localhost:8000/healthz > /dev/null 2>&1
EOF

COPY --chmod=755 <<'EOF' /usr/local/bin/readiness-check.sh
#!/bin/sh
response=$(curl -sf http://localhost:8000/healthz 2>/dev/null)
if [ $? -ne 0 ]; then exit 1; fi
echo "$response" | grep -q '"ok":true' || exit 1
EOF

# Default environment.
#
# K-3 / K-20 (AUDIT_2026-05-18.md): we no longer pre-export
# CAMOU_UTLS_PROFILE here. The uTLS sidecar moved to
# bundle/_experimental/ and is not selected by any registered TLS
# profile, so baking the env var into the image was misleading — it
# suggested the sidecar was on the default path. Operators who really
# want to exercise the experimental sidecar can pass
# `-e CAMOU_UTLS_PROFILE=firefox150` at `docker run`.
ENV CAMOUFOX_SNAPSHOT_DIR=/var/lib/camoufox/snapshots
ENV CAMOUFOX_STORE_BACKEND=file
ENV CAMOUFOX_POOL_BACKEND=memory

# Expose ports
EXPOSE 8000 8080

# Use tini for proper signal handling
ENTRYPOINT ["tini", "--"]

# Default: run session broker
USER camoufox
CMD ["python3", "-m", "camoufox", "cloud-broker", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--snapshot-dir", "/var/lib/camoufox/snapshots", \
     "--pool-size", "5"]
