ac_add_options --disable-maintenance-service
ac_add_options --disable-update-agent
ac_add_options --disable-accessibility

# Disable LTO on the windows-gnu cross-build. base.mozconfig sets
# --enable-release which adds `-Clto` to cargo_rustc_flags, and the final
# Rust archive-pack step (after the "Finished release profile" line in
# cargo) has historically failed ~12-14s post-cargo on libgkrust.a with
# `gmake[3]: *** [config/recurse.mk:34: compile] Error 2` when LTO is
# active on {x86_64,i686}-pc-windows-gnu cross-targets. Linux and macOS
# builds retain LTO via --enable-release in base.mozconfig.
ac_add_options --disable-lto

if [ "$BUILD_TARGET" = "windows,i686" ]; then
    MINGW_TRIPLE=i686-w64-mingw32
else
    MINGW_TRIPLE=x86_64-w64-mingw32
fi

# MinGW cross C/C++ compiler. We deliberately do NOT use a plain
# `clang --target=$MINGW_TRIPLE` string here. mozbuild derives cargo's
# per-target compiler env (CC_<rust_target>) from $(CC) and re-distributes a
# compiler's inline flags via CFLAGS_<rust_target>, which it sources from each
# directory's COMPUTED_CFLAGS. The toolkit/library/rust directory has empty
# COMPUTED_CFLAGS, so the inline --target never reaches cc-rs: build scripts
# like swgl would invoke bare /usr/bin/clang (defaulting to the host
# x86_64-pc-linux-gnu target), which (a) rejects the Windows-only -mguard=cf
# that cc-rs propagates from -Ccontrol-flow-guard=yes, and (b) would emit
# host-arch objects for swgl's src/gl.cc -> later libxul link failure.
# A wrapper binary that bakes --target into the compiler itself survives all of
# mozbuild's flag splitting, because the target is part of the program, not a
# flag that can be stripped or dropped.
_camou_wrap="${MOZBUILD_STATE_PATH:-$HOME/.mozbuild}/camou-mingw"
mkdir -p "$_camou_wrap"
printf '#!/bin/sh\nexec clang --target=%s "$@"\n' "$MINGW_TRIPLE" > "$_camou_wrap/cc"
printf '#!/bin/sh\nexec clang++ --target=%s "$@"\n' "$MINGW_TRIPLE" > "$_camou_wrap/cxx"
chmod +x "$_camou_wrap/cc" "$_camou_wrap/cxx"
export CC="$_camou_wrap/cc"
export CXX="$_camou_wrap/cxx"

# Force libstdc++ into hosted mode for the -ffreestanding winlauncher
# sublibrary. FF150's mozilla/Span.h unconditionally `#include <string>`
# (and <algorithm>/<array>/<iterator>); browser/app/winlauncher/freestanding
# reaches it transitively via NativeNt.h -> Range.h -> Span.h. Under
# -ffreestanding the GCC 13 MinGW libstdc++ sets _GLIBCXX_HOSTED=0, which
# leaves std::allocator / std::basic_string undeclared, so <bits/stringfwd.h>
# fails with "no template named 'allocator'". (The CI requires_hosted.h stub
# only suppresses the earlier #error; it does not bring allocator back.)
# GCC 13's <bits/c++config.h> guards the macro with `#ifndef _GLIBCXX_HOSTED`,
# so predefining it here wins. This is a no-op for every normal (hosted)
# compile -- where __STDC_HOSTED__==1 already yields _GLIBCXX_HOSTED==1 -- so
# it only changes the freestanding objects, and it leaves __STDC_HOSTED__
# itself at 0 so Freestanding.h's "freestanding only" guard still holds.
export CXXFLAGS="${CXXFLAGS:+$CXXFLAGS }-D_GLIBCXX_HOSTED=1"

export RC="$MINGW_TRIPLE-windres"
export WINDRES="$MINGW_TRIPLE-windres"
export AR="$MINGW_TRIPLE-ar"
export RANLIB="$MINGW_TRIPLE-ranlib"

# Statically link the MinGW C/C++ runtime so the packaged camoufox.exe and
# xul.dll have no transitive dependency on libgcc_s_seh-1.dll, libstdc++-6.dll
# or libwinpthread-1.dll. Without this, package-windows would have to ship
# those DLLs alongside the binaries -- and the Makefile only references the
# MSVC redist path, which does not exist on the CI runner (CI uses MinGW gcc,
# not MSVC, and `make bootstrap` is intentionally not invoked). Static linking
# is the cleaner fix: one self-contained ZIP, no host-runtime hunt at startup.
export LDFLAGS="${LDFLAGS:+$LDFLAGS }-static-libgcc -static-libstdc++ -Wl,-Bstatic,-lpthread,-lwinpthread,-Bdynamic"

if command -v llvm-dlltool >/dev/null 2>&1; then
    export LLVM_DLLTOOL=llvm-dlltool
elif command -v llvm-dlltool-18 >/dev/null 2>&1; then
    export LLVM_DLLTOOL=llvm-dlltool-18
fi

if command -v fxc2.exe >/dev/null 2>&1; then
    export FXC="$(command -v fxc2.exe)"
fi

# Wine's d3dcompiler uses strrchr(path, '\\') to find the source-file
# directory for resolving relative #include directives. Unix forward-slash
# paths break Mozilla's HLSL build with E4002 errors. The wine-fxc-wrapper
# translates .hlsl/.hlsli arguments to Z:-drive backslash paths. Prefer the
# wrapper unconditionally when present, even if WINE was pre-set in env, so
# we never bypass the path translation by accident.
if [ -x /usr/local/bin/wine-fxc-wrapper ]; then
    export WINE=/usr/local/bin/wine-fxc-wrapper
elif [ -z "$WINE" ]; then
    if command -v wine64 >/dev/null 2>&1; then
        export WINE="$(command -v wine64)"
    elif command -v wine >/dev/null 2>&1; then
        export WINE="$(command -v wine)"
    elif [ -x /usr/lib/wine/wine64 ]; then
        export WINE=/usr/lib/wine/wine64
    fi
fi
