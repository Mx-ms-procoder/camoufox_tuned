ac_add_options --disable-maintenance-service
ac_add_options --disable-update-agent
ac_add_options --disable-accessibility

# Disable CodeView/PDB debug-symbol generation on the windows-gnu cross-build.
# Mozilla's Windows build adds `-g -gcodeview` and passes `-Wl,-pdb,<name>.pdb`
# so lld writes a PDB per binary. Combined with `--allow-multiple-definition`
# (needed for the clang+mingw-gcc-libstdc++ _M_replace_cold COMDAT mismatch),
# lld keeps two copies of that cold helper and its PDB writer then crashes
# (SIGABRT on x86_64, SIGSEGV on i686: "linker command failed due to signal")
# while linking the small GMP fake plugins (dom/media fake-cdm fake.dll,
# gmp-plugin-openh264 fakeopenh264.dll). A release artifact needs no PDBs, and
# dropping debug info also cuts the memory/time of the still-pending libxul link
# (lowering OOM risk). Linux/macOS keep their debug symbols (base.mozconfig).
ac_add_options --disable-debug-symbols

# Disable LTO on the windows-gnu cross-build. base.mozconfig sets
# --enable-release which adds `-Clto` to cargo_rustc_flags, and the final
# Rust archive-pack step (after the "Finished release profile" line in
# cargo) has historically failed ~12-14s post-cargo on libgkrust.a with
# `gmake[3]: *** [config/recurse.mk:34: compile] Error 2` when LTO is
# active on {x86_64,i686}-pc-windows-gnu cross-targets. Linux and macOS
# builds retain LTO via --enable-release in base.mozconfig.
ac_add_options --disable-lto

# Disable the Windows native notification COM server on the mingw cross-build.
# Upstream toolkit/moz.build only builds toolkit/mozapps/notificationserver for
# clang-cl ("mingw is missing Windows toast notification definitions"), so the
# DLL is never produced here -- yet MOZ_NOTIFICATION_SERVER defaults to True on
# Windows/browser, which makes browser/installer/package-manifest.in:425
#   #if defined(MOZ_NOTIFICATION_SERVER)
#   @BINPATH@/@DLL_PREFIX@notificationserver@DLL_SUFFIX@
# require bin/notificationserver.dll at `./mach package`, failing packaging with
#   error: package-manifest.in:425: Missing file(s): bin/notificationserver.dll
# Disabling the feature mirrors upstream's own "not on mingw" stance: the
# manifest entry is then preprocessed out and packaging no longer expects it.
# Persistent (relaunch-when-closed) toast notifications are unavailable on the
# mingw build either way; foreground notifications are unaffected.
ac_add_options --disable-notification-server

if [ "$BUILD_TARGET" = "windows,i686" ]; then
    MINGW_TRIPLE=i686-w64-mingw32
    # SSE2 baseline for 32-bit, mirroring linux.mozconfig. Firefox's i686 target
    # has required SSE2 since Fx49, and MSVC defaults 32-bit to /arch:SSE2 -- but
    # clang for i686-*-windows-gnu does NOT enable SSE by default, so files that
    # use SSE intrinsics with no per-file flag (e.g. libwebrtc common_audio
    # fir_filter_sse.cc, whose GN->moz.build has no WINNT-x86 -msse2 block) fail
    # with "always_inline function '_mm_*' requires target feature 'sse'". A
    # per-moz.build -msse2 alone did NOT resolve it (run 27829617115); the proven
    # Linux recipe additionally sets -mfpmath=sse, so adopt it wholesale as the
    # global i686 baseline (covers every SSE-assuming TU at once).
    export CFLAGS="$CFLAGS -msse2 -mfpmath=sse"
    export CXXFLAGS="$CXXFLAGS -msse2 -mfpmath=sse"
else
    MINGW_TRIPLE=x86_64-w64-mingw32
fi

# Use EMULATED TLS to match the mingw GCC libstdc++ we statically link. clang
# defaults to native (SECREL) TLS for *-windows-gnu, but mingw GCC builds
# libstdc++ with emulated TLS: its thread-local globals -- notably
# std::__once_call / std::__once_callable that std::call_once references -- are
# emitted as `__emutls_v._ZSt...` control variables, not native-TLS symbols
# (verified with nm on both the win32 and posix libstdc++.a). clang's native-TLS
# references therefore do not resolve against libstdc++'s emutls definitions and
# the libGLESv2.dll link (ANGLE WorkerThread.cpp -> std::call_once/std::async)
# dies with "undefined reference to std::__once_callable" (relocation truncated,
# IMAGE_REL_*_SECREL). -femulated-tls switches clang to the same emutls ABI, so
# the references match libstdc++ and libgcc's __emutls_get_address resolves them.
# Applied globally so every TU's TLS access is consistent.
export CFLAGS="$CFLAGS -femulated-tls"
export CXXFLAGS="$CXXFLAGS -femulated-tls"

# MinGW cross C/C++ compiler. We deliberately do NOT use a plain
# `clang --target=$MINGW_TRIPLE` string here. mozbuild derives cargo's
# per-target compiler env (CC_<rust_target>) from $(CC) and re-distributes a
# compiler's inline flags via CFLAGS_<rust_target>, which it sources from each
# directory's COMPUTED_CFLAGS. The toolkit/library/rust directory has empty
# COMPUTED_CFLAGS, so the inline --target never reaches cc-rs: build scripts
# like swgl would invoke bare /usr/bin/clang (defaulting to the host
# x86_64-pc-linux-gnu target), which (a) rejects the Windows-only -mguard=cf
# that cc-rs propagates from -Ccontrol-flow-guard=yes, and (b) would emit
# host-arch objects for swgl's src/gl.cc -> later libxul link failure.
# A wrapper binary that bakes --target into the compiler itself survives all of
# mozbuild's flag splitting, because the target is part of the program, not a
# flag that can be stripped or dropped.
#
# The wrapper also drops any -Wl,-Xlink=* linker options. Firefox's non-MSVC
# Windows branch emits MSVC/lld-link-only flags wrapped as -Wl,-Xlink=<opt>
# (notably -Xlink=-DELAYLOAD:<dll> from DELAYLOAD_DLLS), but our actual linker
# is GNU binutils ld, which rejects them with
#   ld: Error: unable to disambiguate: -Xlink=-DELAYLOAD:advapi32.dll
# GNU ld has no delay-load support, so we simply drop them: the affected DLLs
# (advapi32/ole32/oleaut32/user32/version/winmm/dbghelp) then load eagerly at
# startup instead of on first use, which is functionally equivalent. The stack
# reserve, the one -Xlink= flag we must keep, is translated to GNU `-Wl,--stack`
# separately in config/config.mk, so by the time the wrapper runs the only
# -Xlink= options left are the safe-to-drop ones.
#
_camou_wrap="${MOZBUILD_STATE_PATH:-$HOME/.mozbuild}/camou-mingw"
mkdir -p "$_camou_wrap"

# TECH#28 (broadened): route the i686 PROGRAM (.exe) links through lld. With the
# undefined-symbol fixes in place, lld links these binaries cleanly (camou-diag
# "lld probe exit=0") but GNU ld STILL exits 1 with no undefined symbols -- a
# GNU-ld-specific failure on the i686 program object set (the `-pie` mingw .exe
# links: winlauncher freestanding, sandbox broker, libxul import + mozglue). It
# first bit camoufox.exe; once that was routed to lld and xul.dll linked, the
# build reached plugin-container.exe and xpcshell.exe, which fail GNU-ld-identically
# and likewise link under lld. The i686 DLLs (xul.dll + satellites) link fine with
# GNU ld, so leave those alone -- only the `*/dist/bin/*.exe` outputs go to lld
# (minimal blast radius; the PDB crash that once forced GNU ld is moot under
# --disable-debug-symbols). x86_64 is GREEN and uses an unmatchable sentinel glob.
if [ "$MINGW_TRIPLE" = "i686-w64-mingw32" ]; then
    _camou_lld_glob='*/dist/bin/*.exe'
else
    _camou_lld_glob='__camou_no_lld_match__'
fi

cat > "$_camou_wrap/cc" <<EOF
#!/bin/sh
n=\$#
while [ \$n -gt 0 ]; do
  a=\$1; shift; n=\$((n - 1))
  case "\$a" in
    -Wl,-Xlink=*) ;;
    *) set -- "\$@" "\$a" ;;
  esac
done
_camou_ld=
for a in "\$@"; do
  case "\$a" in
    $_camou_lld_glob) _camou_ld=-fuse-ld=lld ;;
  esac
done
clang --target=$MINGW_TRIPLE \$_camou_ld "\$@"
rc=\$?
if [ \$rc -ne 0 ]; then
  for a in "\$@"; do
    case "\$a" in
      -shared|*.exe|*.dll)
        _dlog="\${TMPDIR:-/tmp}/camoudiag.\$\$"
        echo "camou-diag: link(cc) failed rc=\$rc; full -v capture (GNU ld):" 1>&2
        clang --target=$MINGW_TRIPLE -v -Wl,--verbose "\$@" > "\$_dlog" 2>&1
        echo "camou-diag: clang -v exit=\$?" 1>&2
        cat "\$_dlog" 1>&2
        echo "camou-diag: lld fallback probe (-fuse-ld=lld):" 1>&2
        clang --target=$MINGW_TRIPLE -fuse-ld=lld -v "\$@" > "\$_dlog" 2>&1
        echo "camou-diag: lld probe exit=\$?" 1>&2
        cat "\$_dlog" 1>&2
        rm -f "\$_dlog"
        break ;;
    esac
  done
fi
exit \$rc
EOF
cat > "$_camou_wrap/cxx" <<EOF
#!/bin/sh
n=\$#
while [ \$n -gt 0 ]; do
  a=\$1; shift; n=\$((n - 1))
  case "\$a" in
    -Wl,-Xlink=*) ;;
    *) set -- "\$@" "\$a" ;;
  esac
done
_camou_ld=
for a in "\$@"; do
  case "\$a" in
    $_camou_lld_glob) _camou_ld=-fuse-ld=lld ;;
  esac
done
clang++ --target=$MINGW_TRIPLE \$_camou_ld "\$@"
rc=\$?
if [ \$rc -ne 0 ]; then
  for a in "\$@"; do
    case "\$a" in
      -shared|*.exe|*.dll)
        _dlog="\${TMPDIR:-/tmp}/camoudiag.\$\$"
        echo "camou-diag: link(cxx) failed rc=\$rc; full -v capture (GNU ld):" 1>&2
        clang++ --target=$MINGW_TRIPLE -v -Wl,--verbose "\$@" > "\$_dlog" 2>&1
        echo "camou-diag: clang -v exit=\$?" 1>&2
        cat "\$_dlog" 1>&2
        echo "camou-diag: lld fallback probe (-fuse-ld=lld):" 1>&2
        clang++ --target=$MINGW_TRIPLE -fuse-ld=lld -v "\$@" > "\$_dlog" 2>&1
        echo "camou-diag: lld probe exit=\$?" 1>&2
        cat "\$_dlog" 1>&2
        rm -f "\$_dlog"
        break ;;
    esac
  done
fi
exit \$rc
EOF
chmod +x "$_camou_wrap/cc" "$_camou_wrap/cxx"
export CC="$_camou_wrap/cc"
export CXX="$_camou_wrap/cxx"

export RC="$MINGW_TRIPLE-windres"
export WINDRES="$MINGW_TRIPLE-windres"
export AR="$MINGW_TRIPLE-ar"
export RANLIB="$MINGW_TRIPLE-ranlib"

# Statically link the MinGW C/C++ runtime so the packaged camoufox.exe and
# xul.dll have no transitive dependency on libgcc_s_seh-1.dll, libstdc++-6.dll
# or libwinpthread-1.dll. Without this, package-windows would have to ship
# those DLLs alongside the binaries -- and the Makefile only references the
# MSVC redist path, which does not exist on the CI runner (CI uses MinGW gcc,
# not MSVC, and `make bootstrap` is intentionally not invoked). Static linking
# is the cleaner fix: one self-contained ZIP, no host-runtime hunt at startup.
#
# --allow-multiple-definition works around a clang+mingw-gcc-libstdc++ COMDAT
# mismatch: libstdc++'s [[gnu::cold]] out-of-line helper
# std::__cxx11::basic_string::_M_replace_cold is emitted by clang into a
# ".text$unlikely$<mangled>" COMDAT, but the GCC-built libstdc++.a ships the same
# symbol in a plain ".text$<mangled>" section in string-inst.o. The differing
# section names defeat COMDAT dedup, so any final binary that links libstdc++.a
# statically AND pulls the symbol from a user TU (e.g. dom/media fake-cdm's
# fake.dll, nmhproxy) fails with "multiple definition of ... _M_replace_cold".
# Both definitions are the identical function, so take-first is safe.
export LDFLAGS="${LDFLAGS:+$LDFLAGS }-static-libgcc -static-libstdc++ -Wl,-Bstatic,-lpthread,-lwinpthread,-Bdynamic -Wl,--allow-multiple-definition"

if command -v llvm-dlltool >/dev/null 2>&1; then
    export LLVM_DLLTOOL=llvm-dlltool
elif command -v llvm-dlltool-18 >/dev/null 2>&1; then
    export LLVM_DLLTOOL=llvm-dlltool-18
fi

if command -v fxc2.exe >/dev/null 2>&1; then
    export FXC="$(command -v fxc2.exe)"
fi

# Wine's d3dcompiler uses strrchr(path, '\\') to find the source-file
# directory for resolving relative #include directives. Unix forward-slash
# paths break Mozilla's HLSL build with E4002 errors. The wine-fxc-wrapper
# translates .hlsl/.hlsli arguments to Z:-drive backslash paths. Prefer the
# wrapper unconditionally when present, even if WINE was pre-set in env, so
# we never bypass the path translation by accident.
if [ -x /usr/local/bin/wine-fxc-wrapper ]; then
    export WINE=/usr/local/bin/wine-fxc-wrapper
elif [ -z "$WINE" ]; then
    if command -v wine64 >/dev/null 2>&1; then
        export WINE="$(command -v wine64)"
    elif command -v wine >/dev/null 2>&1; then
        export WINE="$(command -v wine)"
    elif [ -x /usr/lib/wine/wine64 ]; then
        export WINE=/usr/lib/wine/wine64
    fi
fi
