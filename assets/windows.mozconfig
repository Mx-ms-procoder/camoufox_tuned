ac_add_options --disable-maintenance-service
ac_add_options --disable-update-agent
ac_add_options --disable-accessibility

if [ "$BUILD_TARGET" = "windows,i686" ]; then
    MINGW_TRIPLE=i686-w64-mingw32
else
    MINGW_TRIPLE=x86_64-w64-mingw32
fi

export CC="clang --target=$MINGW_TRIPLE"
export CXX="clang++ --target=$MINGW_TRIPLE"
export RC="$MINGW_TRIPLE-windres"
export WINDRES="$MINGW_TRIPLE-windres"
export AR="$MINGW_TRIPLE-ar"
export RANLIB="$MINGW_TRIPLE-ranlib"

if command -v llvm-dlltool >/dev/null 2>&1; then
    export LLVM_DLLTOOL=llvm-dlltool
elif command -v llvm-dlltool-18 >/dev/null 2>&1; then
    export LLVM_DLLTOOL=llvm-dlltool-18
fi

if command -v fxc2.exe >/dev/null 2>&1; then
    export FXC="$(command -v fxc2.exe)"
fi

if [ -z "$WINE" ]; then
    if command -v wine64 >/dev/null 2>&1; then
        export WINE="$(command -v wine64)"
    elif command -v wine >/dev/null 2>&1; then
        export WINE="$(command -v wine)"
    elif [ -x /usr/lib/wine/wine64 ]; then
        export WINE=/usr/lib/wine/wine64
    fi
fi
