ac_add_options --disable-update-agent

# macOS is cross-compiled from the Linux runner using Mozilla's bootstrapped
# clang + matching macOS SDK, which assets/base.mozconfig enables for the macos
# target via `--enable-bootstrap`. configure auto-selects the cross compiler and
# SDK for the `--target=*-apple-darwin` triple, so no osxcross / CC / CXX /
# --with-macos-sdk overrides are needed here (mirrors upstream camoufox's
# macos.mozconfig, where the osxcross/CROSS block is likewise commented out).
#
# Packaging-related tools that the legacy osxcross flow exported (DSYMUTIL,
# DMG_TOOL, HFS_TOOL) are provided by the bootstrapped toolchain / dmg fetch
# when needed and are intentionally left to configure's defaults.
