# Bundled fonts.
#
# MOZ_BUNDLED_FONTS is what compiles in CoreTextFontList::ActivateBundledFonts(),
# the only caller of ActivateFontsFromDir() -- which is what registers
# <GRE>/fonts with CoreText via CTFontManagerRegisterFontURLs(). Without the
# define that whole path is compiled out, so the fonts we ship under
# Contents/Resources/fonts (Makefile passes `--fonts windows linux` for macOS)
# are never loaded and a spoofed font list resolves against the *host's* fonts
# instead of ours -- i.e. a macOS host answering a Windows font list with the
# 13 families both happen to have, which contradicts the claimed OS rather than
# merely weakening it.
#
# Upstream's default is `target.os == "WINNT" or target.kernel == "Linux"`
# (toolkit/moz.configure), so Linux and Windows get this for free and macOS does
# not. settings/camoufox.cfg already sets gfx.bundled-fonts.activate=1, i.e. the
# pref side was on all along -- only the build flag was missing.
# Adopted from upstream v152.0.4-beta.29 (daijro/camoufox#706).
ac_add_options --enable-bundled-fonts

ac_add_options --disable-update-agent

# macOS is cross-compiled from the Linux runner using Mozilla's bootstrapped
# clang (assets/base.mozconfig enables --enable-bootstrap for the macos target).
# That clang is new enough to parse the macOS 26 SDK's `visionOS` availability
# tokens (host clang-18 could not). configure auto-selects the cross compiler
# for the --target=*-apple-darwin triple.
#
# The macOS SDK itself, however, is Apple-licensed: Mozilla's bootstrapped SDK
# artifact is private (the auto-fetch returns HTTP 403 for external builds), so
# we supply it ourselves. The "Fetch macOS SDK" CI step downloads the public
# MacOSX26.1 SDK and exports MACOS_SDK_DIR; --with-macos-sdk points configure at
# it (which also suppresses the failing bootstrap SDK fetch). FF150's hardcoded
# mac_sdk_min_version=26.2 is lowered to 26.1 by core/macos-sdk-min-version.patch
# because the public SDK mirror tops out at 26.1.
if [ -n "$MACOS_SDK_DIR" ]; then
    ac_add_options --with-macos-sdk="$MACOS_SDK_DIR"
fi
