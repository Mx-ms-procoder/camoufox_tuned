ac_add_options --disable-update-agent
ac_add_options --disable-alsa

# Packaging related
# #export DSYMUTIL="$MOZBUILD/clang/bin/dsymutil"
# export DMG_TOOL="$MOZBUILD/dmg/dmg"
# export HFS_TOOL="$MOZBUILD/dmg/hfsplus"

# Build related
if [ -n "$OSXCROSS_ROOT" ]; then
    mk_add_options "export PATH=$OSXCROSS_ROOT/bin:$PATH"
    mk_add_options "export LD_LIBRARY_PATH=$OSXCROSS_ROOT/lib:$LD_LIBRARY_PATH"
    export HOST_CC="${HOST_CC:-/usr/bin/clang}"
    export HOST_CXX="${HOST_CXX:-/usr/bin/clang++}"

    if [ "$BUILD_TARGET" = "macos,arm64" ]; then
        export CC="$OSXCROSS_ROOT/bin/oa64-clang"
        export CXX="$OSXCROSS_ROOT/bin/oa64-clang++"
    else
        export CC="$OSXCROSS_ROOT/bin/o64-clang"
        export CXX="$OSXCROSS_ROOT/bin/o64-clang++"
    fi

    if [ -n "$MACOS_SDK_DIR" ]; then
        ac_add_options --with-macos-sdk="$MACOS_SDK_DIR"
    fi
fi
