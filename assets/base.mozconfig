ac_add_options --enable-application=browser
 
ac_add_options --allow-addon-sideload
ac_add_options --disable-crashreporter
ac_add_options --disable-backgroundtasks
ac_add_options --disable-debug
# --disable-debug only turns off DEBUG code; it does NOT drop -g. Without this,
# every object file, the gkrust fat-LTO staticlib and the libxul link all carry
# full debug info -- by far the largest thing the objdir holds, and the peak RSS
# of the link. Nothing in scripts/package.py consumes symbol files, so on a
# release build they are pure cost.
#
# Adopted from upstream v152.0.4-beta.29 (daijro/camoufox#698), where it was an
# OOM fix for linux/arm64 container builds. Here it is load-bearing for disk:
# GitHub halved the ubuntu-24.04 runner from 145G to 72G in August 2026 and the
# objdir no longer fits alongside the toolchains with symbols on. See the
# "Create swap space" step in .github/workflows/build.yml.
ac_add_options --disable-debug-symbols
ac_add_options --disable-default-browser-agent
ac_add_options --disable-tests
ac_add_options --disable-updater
# ac_add_options --enable-hardening
# ac_add_options --enable-jxl
# ac_add_options --enable-optimize
ac_add_options --enable-release
# ac_add_options --enable-rust-simd

ac_add_options --disable-system-policies
# ac_add_options --disable-accessibility
# ac_add_options --disable-webspeech
# Keep Gecko's default RLBox isolation for native third-party libraries.

ac_add_options --with-app-name=camoufox
ac_add_options --with-branding=browser/branding/camoufox

ac_add_options --with-unsigned-addon-scopes=app,system

# Use Mozilla's version-matched compiler and WASI toolchain on every target.
# RLBox needs the WASM compiler/sysroot as well as the native C++ compiler.
ac_add_options --enable-bootstrap

# Use ccache for faster incremental rebuilds if available (CONTRIBUTING.md:
# cold build ~40 min, cached rebuilds ~5 min). Guarded so configure does not
# fail with "Cannot find ccache" when it is not installed.
if command -v ccache >/dev/null 2>&1; then
    ac_add_options --with-ccache=ccache
fi

export MOZ_REQUIRE_SIGNING=

mk_add_options MOZ_CRASHREPORTER=0
mk_add_options MOZ_DATA_REPORTING=0
mk_add_options MOZ_SERVICES_HEALTHREPORT=0
mk_add_options MOZ_TELEMETRY_REPORTING=0
mk_add_options MOZ_INSTALLER=0
mk_add_options MOZ_AUTOMATION_INSTALLER=0

# ac_add_options --enable-lto=cross
