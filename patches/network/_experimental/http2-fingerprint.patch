+// K-21 (AUDIT_2026-05-18.md). Resolve an HTTP/2 SETTINGS / framing
+// value through `IdentityStateProvider::GetHttp2State()` if the
+// launcher has opted-in to HTTP/2 fingerprint emission; otherwise
+// return the upstream Firefox default. The cached Http2State lookup
+// compiles to a single branch in the hot path because GetHttp2State
+// is a once_flag-guarded static.
+//
+// `key` is matched against the field names on
+// IdentityStateProvider::Http2State. Keep the string literals in sync
+// with the keys emitted by
+// pythonlib/camoufox/tls_profiles.get_http2_config().
+static inline bool Http2SettingInRange(const char* key, uint32_t value) {
+  if (!strcmp(key, "enablePush")) return value <= 1;
+  if (!strcmp(key, "initialWindowSize")) return value <= 2147483647U;
+  if (!strcmp(key, "maxFrameSize"))
+    return value >= 16384U && value <= 16777215U;
+  if (!strcmp(key, "windowUpdate"))
+    return value >= 1U && value <= 2147483647U;
+  if (!strcmp(key, "priorityWeight")) return value >= 1U && value <= 256U;
+  if (!strcmp(key, "maxConcurrentStreams")) return value >= 1U;
+  return true;
+}
+
+static inline uint32_t ResolveOptionalHttp2Setting(
+    const char* key, const std::optional<uint32_t>& configured,
+    uint32_t upstream_default) {
+  if (!configured || !Http2SettingInRange(key, *configured)) {
+    return upstream_default;
+  }
+  return *configured;
+}
+
+static inline uint32_t ResolveHttp2Setting(const char* key,
+                                           uint32_t upstream_default) {
+  auto state = IdentityStateProvider::GetHttp2State();
+  if (!state) return upstream_default;
+  if (!strcmp(key, "headerTableSize"))
+    return ResolveOptionalHttp2Setting(key, state->headerTableSize, upstream_default);
+  if (!strcmp(key, "enablePush"))
+    return ResolveOptionalHttp2Setting(key, state->enablePush, upstream_default);
+  if (!strcmp(key, "initialWindowSize"))
+    return ResolveOptionalHttp2Setting(key, state->initialWindowSize, upstream_default);
+  if (!strcmp(key, "maxFrameSize"))
+    return ResolveOptionalHttp2Setting(key, state->maxFrameSize, upstream_default);
+  if (!strcmp(key, "maxConcurrentStreams"))
+    return ResolveOptionalHttp2Setting(key, state->maxConcurrentStreams, upstream_default);
+  if (!strcmp(key, "maxHeaderListSize"))
+    return ResolveOptionalHttp2Setting(key, state->maxHeaderListSize, upstream_default);
+  if (!strcmp(key, "windowUpdate"))
+    return ResolveOptionalHttp2Setting(key, state->windowUpdate, upstream_default);
+  if (!strcmp(key, "priorityWeight"))
+    return ResolveOptionalHttp2Setting(key, state->priorityWeight, upstream_default);
+  return upstream_default;
+}
