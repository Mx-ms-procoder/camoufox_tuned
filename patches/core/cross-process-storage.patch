+
+#ifndef mozilla_dom_RoverfoxStorageManager_h
+#define mozilla_dom_RoverfoxStorageManager_h
+
+#include <stdint.h>
+#include "nsString.h"
+
+namespace mozilla {
+namespace dom {
+
+class RoverfoxStorageManager {
+ public:
+  static void PutString(const nsAString& aKey, const nsAString& aValue);
+  static bool GetString(const nsAString& aKey, nsAString& aOut);
+
+  static void PutBool(const nsAString& aKey, bool aValue);
+  static bool GetBool(const nsAString& aKey, bool& aOut);
+
+  static void PutUint(const nsAString& aKey, uint32_t aValue);
+  static bool GetUint(const nsAString& aKey, uint32_t& aOut);
+};
+
+}  // namespace dom
+}  // namespace mozilla
+
+#endif  // mozilla_dom_RoverfoxStorageManager_h
diff --git a/dom/base/RoverfoxStorageManager.cpp b/dom/base/RoverfoxStorageManager.cpp
new file mode 100644
index 0000000000..d2e3f4a5b6
--- /dev/null
+++ b/dom/base/RoverfoxStorageManager.cpp
@@ -0,0 +1,120 @@
+/* -*- Mode: C++; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "RoverfoxStorageManager.h"
+
+#include <limits>
+
+#include "mozilla/Preferences.h"
+#include "mozilla/dom/ContentChild.h"
+#include "nsError.h"
+#include "nsReadableUtils.h"
+#include "nsString.h"
+#include "nsThreadUtils.h"
+
+namespace mozilla {
+namespace dom {
+namespace {
+
+nsCString PrefName(const nsAString& aKey) {
+  nsCString prefName("roverfox.s.");
+  AppendUTF16toUTF8(aKey, prefName);
+  return prefName;
+}
+
+void PutValue(const nsAString& aKey, const nsACString& aValue) {
+  nsCString prefName = PrefName(aKey);
+  nsCString value(aValue);
+  if (ContentChild* child = ContentChild::GetSingleton()) {
+    if (!NS_IsMainThread()) {
+      return;
+    }
+    child->SendRoverfoxStoragePut(prefName, value);
+    return;
+  }
+  Preferences::SetCString(prefName.get(), value);
+}
+
+bool GetValue(const nsAString& aKey, nsACString& aOutValue) {
+  nsCString prefName = PrefName(aKey);
+  if (ContentChild* child = ContentChild::GetSingleton()) {
+    if (!NS_IsMainThread()) {
+      return false;
+    }
+    nsCString value;
+    if (!child->SendRoverfoxStorageGet(prefName, &value)) {
+      return false;
+    }
+    if (value.IsEmpty()) {
+      return false;
+    }
+    aOutValue = value;
+    return true;
+  }
+
+  nsAutoCString value;
+  Preferences::GetCString(prefName.get(), value);
+  if (value.IsEmpty()) {
+    return false;
+  }
+  aOutValue = value;
+  return true;
+}
+
+}  // namespace
+
+/* static */ void
+RoverfoxStorageManager::PutString(const nsAString& aKey,
+                                  const nsAString& aValue) {
+  PutValue(aKey, NS_ConvertUTF16toUTF8(aValue));
+}
+
+/* static */ bool
+RoverfoxStorageManager::GetString(const nsAString& aKey, nsAString& aOut) {
+  nsAutoCString value;
+  if (!GetValue(aKey, value)) {
+    return false;
+  }
+  CopyUTF8toUTF16(value, aOut);
+  return true;
+}
+
+/* static */ void
+RoverfoxStorageManager::PutBool(const nsAString& aKey, bool aValue) {
+  nsAutoCString value(aValue ? "1" : "0");
+  PutValue(aKey, value);
+}
+
+/* static */ bool
+RoverfoxStorageManager::GetBool(const nsAString& aKey, bool& aOut) {
+  nsAutoCString value;
+  if (!GetValue(aKey, value)) {
+    return false;
+  }
+  if (value.EqualsLiteral("1") || value.LowerCaseEqualsLiteral("true")) {
+    aOut = true;
+    return true;
+  }
+  if (value.EqualsLiteral("0") || value.LowerCaseEqualsLiteral("false")) {
+    aOut = false;
+    return true;
+  }
+  return false;
+}
+
+/* static */ void
+RoverfoxStorageManager::PutUint(const nsAString& aKey, uint32_t aValue) {
+  nsAutoCString value;
+  value.AppendInt(aValue);
+  PutValue(aKey, value);
+}
+
+/* static */ bool
+RoverfoxStorageManager::GetUint(const nsAString& aKey, uint32_t& aOut) {
+  nsAutoCString value;
+  if (!GetValue(aKey, value)) {
+    return false;
+  }
+
+  nsresult rv = NS_OK;
+  int64_t parsed = value.ToInteger64(&rv);
+  if (NS_FAILED(rv) || parsed < 0 ||
+      parsed > std::numeric_limits<uint32_t>::max()) {
+    return false;
+  }
+  aOut = static_cast<uint32_t>(parsed);
+  return true;
+}
+
+}  // namespace dom
+}  // namespace mozilla
