diff --git a/docshell/base/BrowsingContext.cpp b/docshell/base/BrowsingContext.cpp
--- a/docshell/base/BrowsingContext.cpp
+++ b/docshell/base/BrowsingContext.cpp
@@ -95,6 +95,7 @@
 #include "nsScriptError.h"
 #include "nsThreadUtils.h"
 #include "xpcprivate.h"
+#include "IdentityStateProvider.hpp"
 
 #include "AutoplayPolicy.h"
 #include "GVAutoplayRequestStatusIPC.h"
@@ -1973,7 +1974,18 @@
     return NS_ERROR_UNEXPECTED;
   }
 
-  mUseRemoteSubframes = aUseRemoteSubframes;
+  // C-5 fix: keep upstream Firefox behaviour (Fission on by default).
+  // The previous patch silently dropped the assignment when no MaskConfig
+  // RuntimeState was present, leaving mUseRemoteSubframes at its
+  // initialization-time value while still returning NS_OK. That made
+  // crossOriginIsolated / SharedArrayBuffer behaviour inconsistent with
+  // the spoofed Firefox version. Only honour an explicit override.
+  bool effective = aUseRemoteSubframes;
+  if (auto runtimeState = IdentityStateProvider::GetRuntimeState();
+      runtimeState && runtimeState->enableRemoteSubframes.has_value()) {
+    effective = runtimeState->enableRemoteSubframes.value();
+  }
+  mUseRemoteSubframes = effective;
   return NS_OK;
 }
 
