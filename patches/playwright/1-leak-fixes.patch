+  // K-6 (AUDIT_2026-05-18.md): the previous body unconditionally
+  // returned false, which also hid any Marionette / DevTools-Remote
+  // session that an operator might run outside the intended Juggler
+  // path. We only lie when the Juggler bootstrap is the active
+  // automation; otherwise we fall back to the upstream check so a
+  // stray Marionette session is correctly reported via
+  // navigator.webdriver.
+  // C-6 fix: cache the env-var lookup as a function-static bool so
+  // navigator.webdriver does not produce a measurable timing channel.
+  // Hot-path getenv() calls (this getter is invoked from JS) leak
+  // through performance.now() side-channels which anti-bot suites use
+  // as a stable Camoufox-vs-vanilla discriminator.
+  static const bool sJugglerMode = []() {
+    const char* v = std::getenv("MOZ_CAMOUFOX_JUGGLER");
+    return v && v[0] == '1' && v[1] == '\0';
+  }();
+  if (sJugglerMode) {
+    return false;
+  }
+#ifdef ENABLE_WEBDRIVER
+  nsCOMPtr<nsIMarionette> marionette = do_GetService(NS_MARIONETTE_CONTRACTID);
+  if (marionette) {
+    bool marionetteRunning = false;
+    marionette->GetRunning(&marionetteRunning);
+    if (marionetteRunning) {
+      return true;
+    }
+  }
+  nsCOMPtr<nsIRemoteAgent> agent = do_GetService(NS_REMOTEAGENT_CONTRACTID);
+  if (agent) {
+    bool remoteAgentRunning = false;
+    agent->GetRunning(&remoteAgentRunning);
+    if (remoteAgentRunning) {
+      return true;
+    }
+  }
+#endif
+  return false;
 }

