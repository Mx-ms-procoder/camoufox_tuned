 #include "unicode/uloc.h"
 #include "unicode/utypes.h"
+#include "MaskConfig.hpp"
 
 namespace mozilla::intl {
 
 using namespace intl::LanguageTagLimits;
 
+
+// Helper methods for header file
+
+// C-1 fix: cache as function-static so the returned pointer outlives
+// the optional<string> that owns the data. The previous implementation
+// returned c_str() from a function-local optional that was destroyed at
+// return — guaranteed use-after-free, which propagated dangling pointers
+// into LanguageSubtag::Set() / strlen() (see Locale.h Language()/Region()/
+// Script() accessors below). MaskConfig itself is immutable post-init,
+// so a single static cache is correct and process-lifetime stable.
+const char* Locale::GetCamouLanguage() {
+  static const std::optional<std::string> cached =
+      MaskConfig::GetString("locale:language");
+  return cached ? cached->c_str() : nullptr;
+}
+
+const char* Locale::GetCamouRegion() {
+  static const std::optional<std::string> cached =
+      MaskConfig::GetString("locale:region");
+  return cached ? cached->c_str() : nullptr;
+}
+
+const char* Locale::GetCamouScript() {
+  static const std::optional<std::string> cached =
+      MaskConfig::GetString("locale:script");
+  return cached ? cached->c_str() : nullptr;
+}
+
+// Publicly exposed methods
+
+const char* Locale::GetCamouLocale() {
+  static std::string locale;
+
+  if (auto lang = MaskConfig::GetString("locale:language"))
+    if (auto region = MaskConfig::GetString("locale:region"))
+      locale = (lang.value() + "-" + region.value());
+  if (auto value = MaskConfig::GetString("navigator.language"))
+    locale = value.value();
+  if (locale.empty())
+    return nullptr;
+  return locale.c_str();
+}
+
+const char* Locale::GetDefaultLocale() {
+  // In Camoufox, GetDefaultLocale is defined outside the header
+  // to access MaskConfig.
+  if (auto value = GetCamouLocale())
+    return value;
+  return uloc_getDefault();
+}
