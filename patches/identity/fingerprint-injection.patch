+// Camoufox: the spoofed viewport is expressed at 100% zoom, and the window is
+// sized to it, so at the default zoom the stored value and Gecko's own value
+// agree exactly (measured: innerWidth 1787 == documentElement.clientWidth
+// 1787). Once the user zooms they must not: real Firefox reports innerWidth in
+// CSS pixels, so it tracks clientWidth at every zoom level, and returning the
+// stored value unchanged left the two 149px apart after a single Ctrl+wheel
+// step — a mismatch no real browser produces and a cheap thing for a site to
+// compare.
+//
+// Scaling the stored value by the zoom factor is not the answer either: Gecko
+// quantises the zoomed viewport to whole device pixels, so the effective
+// factor is 1.091 where GetFullZoom() says 1.1. That left up to 13px of drift
+// and produced fractional widths (1624.5454193343808) that are themselves a
+// tell. While zoomed, Gecko's own number is the correct and self-consistent
+// one, so defer to it and keep the override for the default zoom — which is
+// the only state automation ever runs in.
+static bool CamouIsDefaultZoom(Document* aDoc) {
+  if (aDoc) {
+    if (nsPresContext* pc = aDoc->GetPresContext()) {
+      const float zoom = pc->GetFullZoom();
+      return zoom > 0.999f && zoom < 1.001f;
+    }
+  }
+  return true;
+}
+
 double nsGlobalWindowInner::GetInnerWidth(ErrorResult& aError) {
+  if (auto value = MaskConfig::GetDouble("window.innerWidth"))
+    if (CamouIsDefaultZoom(mDoc)) return value.value();
   FORWARD_TO_OUTER_OR_THROW(GetInnerWidthOuter, (aError), aError, 0);
 }
 
