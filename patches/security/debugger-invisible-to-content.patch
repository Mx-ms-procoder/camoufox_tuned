+
+bool Debugger::CallData::setInvisibleToContent() {
+  if (!args.requireAtLeast(cx, "Debugger.set invisibleToContent", 1)) {
+    return false;
+  }
+  dbg->invisibleToContent = ToBoolean(args[0]);
+
+  for (auto iter = dbg->debuggees.iter(); !iter.done(); iter.next()) {
+    GlobalObject* global = iter.get();
+    Realm* realm = global->realm();
+    realm->updateAllDebuggersInvisibleToContent();
+    realm->updateDebuggerObservesWasm();
+  }
+
+  args.rval().setUndefined();
+  return true;
+}
