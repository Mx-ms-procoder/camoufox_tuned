# Camoufox audit 2026-07-03 — remove the inert window.set* setter island.
#
# Option B removed the WebIDL `partial interface Window { set* }` declarations
# and the manager Is...EnabledForWebIDL gates, so these nsGlobalWindowInner
# setter methods (setWebGLRenderer/Vendor, setNavigator*, setAudioFingerprintSeed,
# setWebRTCIPv4/6, setFontSpacingSeed, setFontList, setSpeechVoices, setTimezone,
# setScreenDimensions/ColorDepth) are unreachable dead code — no WebIDL binding
# and no other caller references them. They could not be excised in-place from
# their originating patches because those patches chain across nsGlobalWindowInner.cpp
# (each hunk's context is the previously-inserted setter). This patch instead runs
# LAST (basename sorts after every feature patch, matching scripts/patch.py's
# basename apply order) and deletes the whole island against the fully-patched tree.
# Verified: applies with no fuzz/rejects after the full chain on real FF150.0.2;
# leaves 0 setter defs/decls; getters and manager Get* (config-driven spoofing)
# are untouched.
diff --git a/dom/base/nsGlobalWindowInner.cpp b/dom/base/nsGlobalWindowInner.cpp
index e526e8c..8d37243 100644
--- a/dom/base/nsGlobalWindowInner.cpp
+++ b/dom/base/nsGlobalWindowInner.cpp
@@ -7715,52 +7715,6 @@ nsISerialEventTarget* nsGlobalWindowInner::SerialEventTarget() const {
   return GetMainThreadSerialEventTarget();
 }
 
-void nsGlobalWindowInner::SetScreenDimensions(int32_t aWidth, int32_t aHeight,
-                                              ErrorResult& aRv) {
-  uint32_t userContextId = ScreenDimensionManager::GetUserContextIdFromWindow(this);
-
-  if (aWidth <= 0 || aHeight <= 0) {
-    aRv.ThrowTypeError("Screen dimensions must be positive integers");
-    return;
-  }
-
-  ScreenDimensionManager::SetDimensions(userContextId, aWidth, aHeight);
-  ScreenDimensionManager::DisableFunction(userContextId);
-
-  // Self-destruct: set to undefined first to bust IC/shape caches on ARM64.
-  if (JSContext* cx = nsContentUtils::GetCurrentJSContext()) {
-    JS::Rooted<JSObject*> global(cx, JS::CurrentGlobalOrNull(cx));
-    if (global) {
-      JS::Rooted<JS::Value> undef(cx, JS::UndefinedValue());
-      JS_SetProperty(cx, global, "setScreenDimensions", undef);
-      JS_DeleteProperty(cx, global, "setScreenDimensions");
-    }
-  }
-}
