+namespace {
+struct CamouReadbackLayout {
+  size_t offset;
+  size_t length;
+  uint32_t channels;
+  bool alpha;
+};
+
+Maybe<CamouReadbackLayout> CamouReadbackLayoutFor(
+    const webgl::ReadPixelsDesc& desc, const webgl::ReadPixelsResult& res,
+    uint64_t available) {
+  if (!desc.noiseSeed || desc.pi.type != LOCAL_GL_UNSIGNED_BYTE ||
+      res.subrect.IsEmpty()) return Nothing();
+  uint32_t channels;
+  bool alpha = false;
+  switch (desc.pi.format) {
+    case LOCAL_GL_RGBA: case LOCAL_GL_BGRA: case LOCAL_GL_SRGB_ALPHA:
+      channels = 4; alpha = true; break;
+    case LOCAL_GL_RGB: case LOCAL_GL_SRGB: channels = 3; break;
+    case LOCAL_GL_LUMINANCE_ALPHA: channels = 2; alpha = true; break;
+    case LOCAL_GL_ALPHA: channels = 1; alpha = true; break;
+    case LOCAL_GL_RED: case LOCAL_GL_LUMINANCE: channels = 1; break;
+    case LOCAL_GL_RG: channels = 2; break;
+    default: return Nothing(); // Integer attachments preserve exact values.
+  }
+  const auto row = CheckedInt<size_t>(desc.packState.skipRows) + res.subrect.y;
+  const auto col = CheckedInt<size_t>(desc.packState.skipPixels) + res.subrect.x;
+  const auto first = row * res.byteStride + col * channels;
+  const auto length = CheckedInt<size_t>(res.subrect.height - 1) * res.byteStride +
+                      CheckedInt<size_t>(res.subrect.width) * channels;
+  const auto end = first + length;
+  if (!first.isValid() || !length.isValid() || !end.isValid() ||
+      end.value() > available) return Nothing();
+  return Some(CamouReadbackLayout{first.value(), length.value(), channels, alpha});
+}
+
+void CamouNoiseReadback(uint8_t* bytes, const CamouReadbackLayout& layout,
+                        const webgl::ReadPixelsDesc& desc,
+                        const webgl::ReadPixelsResult& res) {
+  camoufox::ApplyByteReadbackNoise(
+      bytes, layout.length, res.subrect.width, res.subrect.height,
+      layout.channels, layout.alpha, desc.noiseSeed, res.byteStride, 0,
+      uint32_t(int64_t(desc.srcOffset.x) + res.subrect.x),
+      uint32_t(int64_t(desc.srcOffset.y) + res.subrect.y));
+}
+} // namespace
+
 webgl::ReadPixelsResult WebGLContext::ReadPixelsInto(
     const webgl::ReadPixelsDesc& desc, const Range<uint8_t>& dest) {
   const FuncScope funcScope(*this, "readPixels");
@@ -911,8 +960,12 @@
     return {};
   }
 
-  return ReadPixelsImpl(desc, reinterpret_cast<uintptr_t>(dest.begin().get()),
-                        dest.length());
+  const auto res = ReadPixelsImpl(
+      desc, reinterpret_cast<uintptr_t>(dest.begin().get()), dest.length());
+  if (auto layout = CamouReadbackLayoutFor(desc, res, dest.length())) {
+    CamouNoiseReadback(dest.begin().get() + layout->offset, *layout, desc, res);
+  }
+  return res;
 }
 
 void WebGLContext::ReadPixelsPbo(const webgl::ReadPixelsDesc& desc,
@@ -959,8 +1012,24 @@
 
   const ScopedLazyBind lazyBind(gl, LOCAL_GL_PIXEL_PACK_BUFFER, buffer);
 
-  ReadPixelsImpl(desc, offset, bytesAvailable);
-
+  const auto res = ReadPixelsImpl(desc, offset, bytesAvailable);
+  if (auto layout = CamouReadbackLayoutFor(desc, res, bytesAvailable)) {
+    // Transform the actual PBO storage so copies, partial reads, and subsequent
+    // GPU uploads observe the same pixels as direct ArrayBuffer readback.
+    auto* bytes = static_cast<uint8_t*>(gl->fMapBufferRange(
+        LOCAL_GL_PIXEL_PACK_BUFFER, offset + layout->offset, layout->length,
+        LOCAL_GL_MAP_READ_BIT | LOCAL_GL_MAP_WRITE_BIT));
+    if (!bytes) {
+      // Do not expose an unprotected readback after a driver mapping failure.
+      LoseContext();
+      return;
+    }
+    CamouNoiseReadback(bytes, *layout, desc, res);
+    if (!gl->fUnmapBuffer(LOCAL_GL_PIXEL_PACK_BUFFER)) {
+      LoseContext();
+      return;
+    }
+  }
   buffer->ResetLastUpdateFenceId();
 }
 
